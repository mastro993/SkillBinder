#!/bin/bash
# Run a parity Python script with Pillow and numpy. The first run creates a virtual environment
# outside the repository, in $SKILLBINDER_PARITY_TOOLS (default: $TMPDIR/skillbinder-parity).
# usage: py <script.py> [args...]
set -euo pipefail
TOOLS="${SKILLBINDER_PARITY_TOOLS:-${TMPDIR:-/tmp}/skillbinder-parity}"
VENV="$TOOLS/venv"
if ! "$VENV/bin/python" -c 'import numpy, PIL' 2>/dev/null; then
  echo "py: installing Pillow and numpy into $VENV" >&2
  python3 -m venv "$VENV"
  "$VENV/bin/python" -m pip install --quiet --disable-pip-version-check pillow==13.0.0 numpy==2.5.4 >&2
fi
exec "$VENV/bin/python" -I "$@"
