{
  "name": "skillbinder",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "dev:frontend": "pnpm --filter @skillbinder/frontend dev:fixture",
    "build": "node scripts/run.mjs build",
    "lint": "oxlint",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:check:rust": "cargo fmt --all --check",
    "typecheck": "pnpm --filter @skillbinder/frontend typecheck",
    "contracts:generate": "node scripts/contracts.mjs generate",
    "contracts:check": "node scripts/contracts.mjs check",
    "test": "pnpm --filter @skillbinder/frontend test && node scripts/check-architecture.mjs && node scripts/registry.mjs check",
    "registry:check": "node scripts/registry.mjs check",
    "registry:docs": "node scripts/registry.mjs docs",
    "test:rust": "cargo test --workspace",
    "test:integration": "cargo test --workspace --tests",
    "test:e2e": "node scripts/pending-check.mjs desktop-e2e",
    "test:runtime": "node scripts/pending-check.mjs runtime-smoke",
    "verify": "pnpm format:check && pnpm format:check:rust && pnpm lint && pnpm lint:rust && pnpm typecheck && pnpm contracts:check && pnpm test && pnpm test:rust"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@shadcn/lint": "^0.1.3",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.14.1",
    "pnpm": "10.33.0"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
