* text=auto eol=lf
fixtures/** -text
assets/** -text

# Files agents do not write. The pre-commit hook skips them in its size check, and GitHub
# collapses them in diffs.
Cargo.lock linguist-generated
skills-lock.json linguist-generated
/clippy.toml linguist-generated
fixtures/baseline/** linguist-generated
# Prototype bundles the kit's inliner builds from docs/design/**/source/, and the icon block its
# generator writes from assets/. Agents edit the sources, never these.
docs/design/**/prototypes/*.html linguist-generated
docs/design/**/source/kit/icons.js.parts/2-generated.js linguist-generated
assets/** linguist-vendored
# Agents update the asset inventories, so the size check covers them.
assets/**/*.json -linguist-vendored
.agents/skills/** linguist-vendored
LICENSE linguist-vendored
