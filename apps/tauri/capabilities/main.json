{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Minimum permissions for the bundled SkillBinder window",
  "windows": ["main"],
  "permissions": [
    "allow-system-bootstrap",
    "allow-git-environment-verify",
    "allow-onboarding-progress-update",
    "allow-onboarding-complete-local",
    "allow-diagnostics-reveal-logs",
    "allow-discovery-start",
    "allow-discovery-results",
    "allow-discovery-cancel",
    "allow-discovery-current",
    "allow-roots-pick",
    "allow-roots-register",
    "allow-roots-list",
    "allow-roots-update",
    "allow-roots-remove",
    "allow-imports-prepare",
    "allow-imports-apply",
    "allow-library-list",
    "allow-library-skill-preview",
    "allow-library-resolve-conflict",
    "allow-library-organization-change",
    "allow-library-organization-preview-delete",
    "allow-git-sync-status",
    "allow-git-sync-connect",
    "allow-git-sync-refresh",
    "allow-git-sync-pull",
    "allow-git-sync-push",
    "allow-git-sync",
    "allow-git-sync-disconnect",
    "pilot:default"
  ]
}
